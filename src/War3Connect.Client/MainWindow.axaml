<Window x:Class="War3Connect.Client.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="War3 Connect · 对战平台" Width="1280" Height="900" MinWidth="1080" MinHeight="760" Background="#0B1220" Foreground="#E4EBF5" FontFamily="Microsoft YaHei UI, Noto Sans CJK SC, sans-serif" FontSize="13" Closing="WindowClosing">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <Border Width="48" Height="48" CornerRadius="13" Background="#E2B777" Margin="0,0,14,0"><TextBlock Text="W" FontSize="28" FontWeight="Bold" Foreground="#192131" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="WAR3 CONNECT" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="登录平台，开启一场属于朋友的对战。" Classes="muted" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
      <Border Grid.Column="2" Classes="badge" VerticalAlignment="Top"><TextBlock x:Name="GameBadge" Text="CLASSIC TFT  /  1.27" FontSize="11" Foreground="#E2B777" /></Border>
    </Grid>
    <Border Grid.Row="1" Classes="card" Padding="18" Margin="0,0,0,18">
      <Grid ColumnDefinitions="2*,*,*,Auto">
        <StackPanel Margin="0,0,18,0">
          <TextBlock Text="服务器连接" Classes="label"/>
          <Grid ColumnDefinitions="*,Auto,Auto"><TextBox x:Name="ServerBox" Watermark="https://play.example.com"/><Button Grid.Column="1" x:Name="SaveServerButton" Content="保存" Click="SaveServerClick" Classes="quiet" Margin="8,0,0,0"/><Button Grid.Column="2" x:Name="DefaultServerButton" Content="默认" Click="DefaultServerClick" Classes="quiet" Margin="6,0,0,0"/></Grid>
          <CheckBox x:Name="AllowHttpBox" Content="允许 HTTP（无证书）" FontSize="11" Margin="0,6,0,0" MinHeight="24"/>
          <TextBlock Text="HTTP 不加密密码及对局数据，仅在可信网络使用。" FontSize="11" Foreground="#E2B777" TextWrapping="Wrap" IsVisible="{Binding IsChecked, ElementName=AllowHttpBox}" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="用户名" Classes="label"/><TextBox x:Name="UsernameBox" Watermark="你的对战昵称" MaxLength="20"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,18,0"><TextBlock Text="密码" Classes="label"/><TextBox x:Name="PasswordBox" Watermark="至少 8 位" PasswordChar="●" MaxLength="128"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock x:Name="AccountText" Text="未登录" Classes="label"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="LoginButton" Content="登录" Click="LoginClick" Classes="primary"/><Button x:Name="RegisterButton" Content="注册" Click="RegisterClick"/><Button x:Name="LogoutButton" Content="退出" Click="LogoutClick" IsEnabled="False" Classes="quiet"/></StackPanel></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="270,18,*">
      <Border Classes="card" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="游戏准备" FontSize="17" FontWeight="SemiBold"/>
            <ComboBox x:Name="GameSelector" SelectedIndex="0" SelectionChanged="GameSelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="魔兽争霸 III · 1.27"/><ComboBoxItem Content="星际争霸 · 1.16.1（准备）"/></ComboBox><TextBlock x:Name="GameDescription" Text="选择经典 TFT 1.27 的游戏程序。" Classes="muted" TextWrapping="Wrap"/>
            <TextBox x:Name="GamePathBox" IsReadOnly="True" Watermark="尚未选择 war3.exe" TextWrapping="Wrap" MinHeight="68" MaxHeight="92" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="GameBrowseButton" Content="选择游戏目录中的 war3.exe" Click="BrowseGameClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <TextBlock x:Name="VersionText" Text="入房前会自动检查游戏版本。" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel x:Name="WinePanel" Spacing="8"><TextBlock Text="WINE 环境" Classes="label"/><TextBox x:Name="WineBox" Watermark="wine"/><TextBox x:Name="WinePrefixBox" Watermark="WINEPREFIX（可留空）" ToolTip.Tip="独立 Wine 环境的绝对路径，留空使用环境默认值"/></StackPanel>
            <Button x:Name="LaunchButton" Content="启动 War3" Click="LaunchClick" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Border Height="1" Background="#263449" Margin="0,6"/>
            <TextBlock Text="一起开局" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameSteps" Text="01  创建或加入平台房间&#10;&#10;02  房主在 War3 局域网中建图&#10;&#10;03  玩家从游戏内主机列表加入" Classes="muted" TextWrapping="Wrap" LineHeight="19"/>
            <Border Background="#18283A" CornerRadius="8" Padding="12"><TextBlock x:Name="GameNotice" Text="地图由游戏内选择、下载和校验。对战期间请保持平台运行。" Foreground="#9CB3CA" FontSize="11" TextWrapping="Wrap" LineHeight="18"/></Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2" x:Name="WorkspaceGrid">
        <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="240"/><RowDefinition Height="12"/><RowDefinition Height="230" MinHeight="150"/></Grid.RowDefinitions>
        <Border x:Name="RoomWorkspacePanel" Classes="card" Padding="16">
          <TabControl x:Name="RoomTabs">
            <TabItem Header="对战大厅">
              <Grid RowDefinitions="*,Auto" Margin="0,12,0,0">
                <Grid Margin="0,0,0,12">
                  <ListBox x:Name="RoomsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,3" Background="#182538" CornerRadius="8"><StackPanel Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Classes="muted" FontSize="11"><Run Text="{Binding HostName}"/><Run Text="  ·  版本 "/><Run Text="{Binding GameVersion}"/></TextBlock><TextBlock Text="需要房间密码" Foreground="#E2B777" FontSize="11" IsVisible="{Binding HasPassword}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel x:Name="EmptyRoomsPanel" IsVisible="{Binding !ItemCount, ElementName=RoomsList}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Spacing="8"><TextBlock x:Name="EmptyRoomTitle" Text="等待下一场对战" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyRoomHint" Text="登录后创建房间，邀请朋友一起加入。" Classes="muted" HorizontalAlignment="Center"/></StackPanel>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,170,Auto">
                  <TextBox x:Name="RoomNameBox" Watermark="新房间名称" Text="朋友的对战房间" MaxLength="40" Margin="0,0,8,0"/>
                  <TextBox Grid.Column="1" x:Name="RoomPasswordBox" Watermark="房间密码（选填）" PasswordChar="●" MaxLength="64" Margin="0,0,8,0"/>
                  <Button Grid.Column="2" Content="刷新" Click="RefreshClick" Classes="quiet"/>
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button x:Name="CreateButton" Content="创建房间" Click="CreateClick" Classes="primary"/><Button x:Name="JoinButton" Content="加入选中房间" Click="JoinClick"/></StackPanel>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="当前房间">
              <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                <StackPanel Spacing="5" Margin="0,0,0,10"><TextBlock x:Name="RoomTitle" Text="尚未加入房间" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MembersText" TextWrapping="Wrap"/><TextBlock x:Name="GameStatusText" Text="加入平台房间后，在 War3 的局域网列表中进入游戏。" Classes="muted" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                <TextBox Grid.Row="1" x:Name="MessagesBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0"><TextBox x:Name="ChatBox" Watermark="给队友发一条消息…" MaxLength="500" KeyDown="ChatKeyDown"/><Button Grid.Column="1" Content="发送" Click="SendClick" Classes="primary" Margin="8,0,0,0"/><Button Grid.Column="2" Content="退出房间" Click="LeaveClick" Classes="quiet" Margin="8,0,0,0"/></Grid>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
        <GridSplitter x:Name="LogSplitter" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="Transparent"><GridSplitter.Template><ControlTemplate><Border Background="{TemplateBinding Background}"><Border Width="40" Height="3" CornerRadius="2" Background="#36475E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></GridSplitter.Template></GridSplitter>
        <Border Grid.Row="2" Classes="card" Padding="14">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Border Width="7" Height="7" CornerRadius="4" Background="#60C9B1" VerticalAlignment="Center"/><TextBlock Text="连接日志" FontSize="15" FontWeight="SemiBold"/></StackPanel><Button Grid.Column="1" x:Name="ExpandLogButton" Content="展开查看" Click="ExpandLogsClick" Classes="quiet compact"/></Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
              <TextBox x:Name="LogFilterBox" Watermark="搜索日志关键字…" TextChanged="LogFilterChanged" MinHeight="30" Padding="9,5"/>
              <CheckBox Grid.Column="1" x:Name="AutoScrollBox" Content="跟随最新" IsChecked="True" Click="FollowLogsClick" FontSize="11" Margin="12,0"/>
              <Button Grid.Column="2" x:Name="CopyLogButton" Content="复制" Click="CopyLogsClick" Classes="quiet compact" ToolTip.Tip="复制当前筛选结果"/>
              <Button Grid.Column="3" x:Name="ExportLogButton" Content="导出" Click="ExportLogsClick" Classes="quiet compact" Margin="6,0" ToolTip.Tip="导出当前筛选结果为文本文件"/>
              <Button Grid.Column="4" x:Name="ClearLogButton" Content="清空" Click="ClearLogsClick" Classes="quiet compact"/>
            </Grid>
            <TextBox Grid.Row="2" x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, Noto Sans Mono, monospace" FontSize="12" Background="#0A1220" BorderBrush="#24334A" Watermark="连接事件会显示在这里。可搜索、复制或导出排查问题。"/>
            <TextBlock Grid.Row="3" x:Name="LogSummaryText" Text="0 条记录 · 保留最近 500 条" Classes="muted" FontSize="10" Margin="0,7,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
