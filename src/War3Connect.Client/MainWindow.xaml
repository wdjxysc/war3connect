<Window x:Class="War3Connect.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="War3 Connect · 1.27 内测版" Width="1200" Height="900" MinWidth="1120" MinHeight="830" Background="#0D1520" Foreground="#DCE6EF" FontFamily="Microsoft YaHei UI" FontSize="13" Closing="WindowClosing">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="TFT 1.27  /  内测版" Foreground="#91A3B6" VerticalAlignment="Center"/><TextBlock Text="WAR3 CONNECT" FontSize="26" FontWeight="Bold" Foreground="#D4AB63"/></DockPanel>
      <TextBlock x:Name="StatusText" Text="连接服务器并登录，和朋友一起进入战场。" TextWrapping="Wrap" Foreground="#91A3B6"/>
    </StackPanel>
    <GroupBox DockPanel.Dock="Top" Header="账号与服务器" Margin="0,0,0,14" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="服务器地址（远程使用 HTTPS）"/>
          <TextBox x:Name="ServerBox" Margin="0"/>
          <WrapPanel Margin="0,7,0,0">
            <Button x:Name="SaveServerButton" Content="保存地址" Click="SaveServerClick" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="DefaultServerButton" Content="使用默认" Click="DefaultServerClick" Padding="10,4" Margin="0"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="用户名"/><TextBox x:Name="UsernameBox" MaxLength="20" Margin="0"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="密码（至少 8 位）"/><PasswordBox x:Name="PasswordBox" MaxLength="128" Margin="0"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock x:Name="AccountText" Text="未登录" Foreground="#91A3B6"/><WrapPanel><Button x:Name="LoginButton" Content="登录" Click="LoginClick" Margin="0,0,8,0"/><Button x:Name="RegisterButton" Content="注册" Click="RegisterClick" Margin="0,0,8,0"/><Button x:Name="LogoutButton" Content="退出账号" Click="LogoutClick" IsEnabled="False" Margin="0"/></WrapPanel></StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox DockPanel.Dock="Bottom" Header="连接日志" Margin="0,14,0,0" Height="80" Padding="12">
      <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" FontSize="11"/>
    </GroupBox>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="游戏设置" Margin="0,0,14,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="01  选择游戏主程序" FontWeight="SemiBold"/>
          <TextBlock Text="使用经典 TFT 1.27 的 war3.exe。" FontSize="11" Foreground="#91A3B6" TextWrapping="Wrap"/>
          <TextBox x:Name="GamePathBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>
          <Button x:Name="GameBrowseButton" Content="选择游戏" Click="BrowseGameClick" HorizontalAlignment="Left" Margin="0,0,0,2"/>
          <TextBlock Text="02  选择本局地图" FontWeight="SemiBold" Margin="0,8,0,6"/>
          <TextBlock Text="地图需放在游戏目录的 Maps 文件夹中，所有玩家使用同一份文件。" FontSize="11" Foreground="#91A3B6" TextWrapping="Wrap"/>
          <TextBox x:Name="MapPathBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>
          <Button x:Name="MapBrowseButton" Content="选择地图" Click="BrowseMapClick" HorizontalAlignment="Left" Margin="0,0,0,2"/>
          <TextBlock x:Name="VersionText" Text="创建或加入房间时自动检查版本和地图。" TextWrapping="Wrap" Foreground="#91A3B6" FontSize="11" Margin="0,5,0,4"/>
          <Button Content="启动 War3（窗口模式）" Click="LaunchClick" Margin="0,0,0,10"/>
          <TextBlock Text="房主在游戏内建图；其他玩家通过局域网列表加入。对战期间保持平台运行。" Foreground="#91A3B6" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel></ScrollViewer>
      </GroupBox>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="230"/></Grid.RowDefinitions>
        <GroupBox Header="对战大厅" Margin="0,0,0,12" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <ListBox x:Name="RoomsList" Background="#101923" Foreground="#DCE6EF" BorderBrush="#2B3A4C" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock FontSize="11" Foreground="#8FA3B8"><Run Text="{Binding HostName}"/><Run Text="  ·  "/><Run Text="{Binding GameVersion}"/><Run Text="  ·  "/><Run Text="{Binding MapName}"/><Run Text="  ·  密码："/><Run Text="{Binding HasPassword}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="暂无房间，可以创建一个" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6D8197" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RoomsList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
            <StackPanel Grid.Row="1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RoomNameBox" Text="朋友的对战房间" MaxLength="40" Margin="0,0,8,6" ToolTip="新房间名称"/><PasswordBox Grid.Column="1" x:Name="RoomPasswordBox" Margin="0,0,8,6" MaxLength="64" ToolTip="房间密码，留空表示公开"/><Button Grid.Column="2" Content="刷新" Click="RefreshClick" Margin="0,0,0,6"/></Grid>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="右侧密码可留空" Foreground="#91A3B6" FontSize="11" VerticalAlignment="Center"/><WrapPanel><Button x:Name="CreateButton" Content="创建房间" Click="CreateClick" Margin="0,0,8,0"/><Button x:Name="JoinButton" Content="加入选中房间" Click="JoinClick" Margin="0"/></WrapPanel></DockPanel>
            </StackPanel>
          </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="当前房间" Margin="0" Padding="14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="RoomTitle" Text="尚未加入房间" FontWeight="Bold" Margin="0,0,0,3"/><TextBlock x:Name="MembersText" TextWrapping="Wrap" Margin="0,0,0,3"/><TextBlock x:Name="GameStatusText" Text="房主建图后，进入 War3 → 局域网加入。" Foreground="#91A3B6" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/></StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="退出房间" Click="LeaveClick" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="发送" Click="SendClick" Margin="8,0,0,0"/><TextBox x:Name="ChatBox" MaxLength="500" KeyDown="ChatKeyDown" Margin="0"/></DockPanel>
            <TextBox x:Name="MessagesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0"/>
          </DockPanel>
        </GroupBox>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
