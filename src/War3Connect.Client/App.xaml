<Application x:Class="War3Connect.Client.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#182332"/>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,3,0,6"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="BorderBrush" Value="#344356"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="BorderBrush" Value="#344356"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,3,8,8"/><Setter Property="Background" Value="#D4AB63"/><Setter Property="Foreground" Value="#14202B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E9C889"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="#DCE6EF"/><Setter Property="BorderBrush" Value="#2B3A4C"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><Border Background="#131E2B" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}" Foreground="#D4AB63" FontWeight="SemiBold" Margin="0,0,0,12"/><ContentPresenter/></DockPanel></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
