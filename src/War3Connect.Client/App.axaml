<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="War3Connect.Client.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock"><Setter Property="Margin" Value="0,3,0,6" /></Style>
    <Style Selector="TextBox"><Setter Property="Margin" Value="0,3,0,10" /><Setter Property="Padding" Value="9,7" /></Style>
    <Style Selector="Button"><Setter Property="Margin" Value="0,3,8,8" /><Setter Property="Padding" Value="14,8" /><Setter Property="Background" Value="#D4AB63" /><Setter Property="Foreground" Value="#14202B" /></Style>
  </Application.Styles>
</Application>
